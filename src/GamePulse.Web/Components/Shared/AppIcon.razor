@switch (Name)
{
    case "overview":
        <svg @attributes="SvgAttributes"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        break;
    case "retention":
        <svg @attributes="SvgAttributes"><path d="M3 17l5-6 4 3 7-9"/><path d="M17 5h2v2"/></svg>
        break;
    case "funnel":
        <svg @attributes="SvgAttributes"><path d="M3 5h18l-7 8v5l-4 2v-7z"/></svg>
        break;
    case "upload":
        <svg @attributes="SvgAttributes"><path d="M12 16V3"/><path d="m7 8 5-5 5 5"/><path d="M5 13v7h14v-7"/></svg>
        break;
    case "menu":
        <svg @attributes="SvgAttributes"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        break;
    case "close":
        <svg @attributes="SvgAttributes"><path d="m6 6 12 12M18 6 6 18"/></svg>
        break;
    case "calendar":
        <svg @attributes="SvgAttributes"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg>
        break;
    case "check":
        <svg @attributes="SvgAttributes"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg>
        break;
    case "error":
        <svg @attributes="SvgAttributes"><circle cx="12" cy="12" r="9"/><path d="m9 9 6 6M15 9l-6 6"/></svg>
        break;
    default:
        <svg @attributes="SvgAttributes"><circle cx="12" cy="12" r="9"/></svg>
        break;
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string? CssClass { get; set; }

    private Dictionary<string, object> SvgAttributes => new()
    {
        ["class"] = CssClass ?? "app-icon",
        ["viewBox"] = "0 0 24 24",
        ["fill"] = "none",
        ["stroke"] = "currentColor",
        ["stroke-width"] = "1.8",
        ["stroke-linecap"] = "round",
        ["stroke-linejoin"] = "round",
        ["aria-hidden"] = "true",
        ["focusable"] = "false",
    };
}
